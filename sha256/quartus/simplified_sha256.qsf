set_global_assignment -name FAMILY "Arria II GX"
set_global_assignment -name DEVICE EP2AGX45DF29I5
set_global_assignment -name TOP_LEVEL_ENTITY simplified_sha256
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/simplified_sha256.sv
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
# project requirement: no inferred megafunctions and 0 block memory bits.
# these are the "Auto RAM Replacement" and "Auto Shift Register Replacement" settings
# under Assignments > Settings > Compiler Settings > Advanced Settings (Synthesis).
# Auto ROM Replacement is also off so the K constant table stays in logic.
set_global_assignment -name AUTO_RAM_RECOGNITION OFF
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name AUTO_ROM_RECOGNITION OFF
